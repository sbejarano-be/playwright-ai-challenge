# Copia este archivo como .env y completa los valores. .env está en .gitignore: nunca subas claves al repositorio.
# Las variables del entorno tienen prioridad sobre este archivo. Con ENV=<nombre> se carga .env.<nombre>.

# Aplicación bajo prueba
BASE_URL=https://automationexercise.com

# Proveedor de IA: openai | anthropic | gemini | ollama | none. Debe coincidir con el proveedor de la clave
# (una clave de Gemini necesita AI_PROVIDER=gemini).
AI_PROVIDER=openai
# Clave del proveedor (no se necesita con ollama). Sin clave, las pruebas cuyo oráculo es la IA se omiten
# con el motivo y la generación de datos usa Faker como respaldo.
AI_API_KEY=
# Modelo. Por defecto: gpt-4o-mini (openai), claude-haiku-4-5 (anthropic), gemini-3.8-flash (gemini), llama3.1 (ollama).
AI_MODEL=gpt-4o-mini
# Opcional: URL base alternativa (gateway compatible con OpenAI u Ollama remoto).
AI_BASE_URL=
# Tiempo máximo por llamada a la IA, en milisegundos.
AI_TIMEOUT_MS=30000
# Confianza mínima (0 a 1) para aprobar una aserción semántica.
AI_ASSERT_THRESHOLD=0.8

# Auto-reparación de selectores: report (anota y continúa) | strict (falla si repara) | off
HEALING_MODE=report

# Opcional: ruta a un JSON de datos adjunto en un reporte, para repetir una ejecución con los mismos datos.
TEST_DATA_FILE=

# Opcional: proxy corporativo para el navegador.
HTTPS_PROXY=
